ES_USER="elastic"
ES_PASSWORD="elastic"
ES_HOST="localhost"
DUCKDB_FILENAME="data/applehealth.duckdb"
# Separate, writable DuckDB file for data logged at runtime (e.g. fueling
# events) — created automatically on first write, never touched by the
# offline importer. Each write is CHECKPOINTed to disk immediately and mirrored
# to manual_logs.fueling_events.json alongside it.
# A relative path is resolved against the repo root (not the process CWD); an
# absolute path or an http(s):// URL is used as-is. Same rules for DUCKDB_FILENAME.
LOGS_DUCKDB_FILENAME="data/manual_logs.duckdb"
CHUNK_SIZE="50000"
RAW_XML_PATH="raw.xml"
# Optional: skip importing records/workouts older than this many months (unset = import everything)
# IMPORT_LOOKBACK_MONTHS=3
# DuckDB query result cache (in-process, TTL + LRU). applehealth.duckdb is rebuilt
# atomically by `make duckdb` — a fresh file is swapped in via os.replace, so
# re-running never duplicates data and a failed run leaves the existing DB intact.
# Restart the MCP server (or wait out the TTL below) after a re-import to pick up
# the new file.
# DUCKDB_QUERY_CACHE_ENABLED=true
# DUCKDB_QUERY_CACHE_TTL_SECONDS=1800
# DUCKDB_QUERY_CACHE_MAXSIZE=256
