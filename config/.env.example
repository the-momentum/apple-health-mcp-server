ES_USER="elastic"
ES_PASSWORD="elastic"
ES_HOST="localhost"
DUCKDB_FILENAME="applehealth.duckdb"
# Separate, writable DuckDB file for data logged at runtime (e.g. fueling
# events) — created automatically on first write, never touched by the
# offline importer.
LOGS_DUCKDB_FILENAME="manual_logs.duckdb"
CHUNK_SIZE="50000"
RAW_XML_PATH="raw.xml"
# Optional: skip importing records/workouts older than this many months (unset = import everything)
# IMPORT_LOOKBACK_MONTHS=3
# DuckDB query result cache (in-process, TTL + LRU). applehealth.duckdb is a static
# file rebuilt only offline via `make duckdb`, so no cache invalidation on write is
# needed — this purely reduces redundant/overlapping DuckDB queries within a run.
# DUCKDB_QUERY_CACHE_ENABLED=true
# DUCKDB_QUERY_CACHE_TTL_SECONDS=1800
# DUCKDB_QUERY_CACHE_MAXSIZE=256
