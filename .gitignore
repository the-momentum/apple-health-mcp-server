# Python
__pycache__/
*.py[cod]
.venv/

# Packaging (uv build / editable install)
dist/
*.egg-info/

# Tool caches & test artifacts
.ruff_cache/
.ty_cache/
.pytest_cache/
.coverage

# Editors & OS
.vscode/
.idea/
.DS_Store

# Local & personal config — never commit
.env
.env.*
!.env.example
.claude/settings.local.json

# Personal health data — never commit
# Raw Apple Health export: the .zip download and the unzipped folder's
# contents (GPS routes, clinical records, ECG data, export.xml). The folder
# itself is kept in the repo via .gitkeep as the drop target for export.xml.
*.zip
apple_health_export/*
!apple_health_export/.gitkeep
*.xml

# Databases & data derived from the export
data/
applehealth.chdb/
*.duckdb
*.duckdb.wal
*.duckdb-wal
*.parquet
*.chdb

# Personal skills (not for upstream)
skills/
